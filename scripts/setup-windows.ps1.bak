$ErrorActionPreference = "Stop"
$Root = Split-Path -Parent $PSScriptRoot
$Backend = Join-Path $Root "backend"
$VenvPython = Join-Path $Backend ".venv\Scripts\python.exe"

Write-Host "AGASTYA Windows setup" -ForegroundColor Green
if (-not (Get-Command py -ErrorAction SilentlyContinue) -and -not (Get-Command python -ErrorAction SilentlyContinue)) {
  throw "Python not found. Install Python 3.11, 3.12, or 3.13 and enable 'Add Python to PATH'."
}
if (-not (Test-Path (Join-Path $Root ".env"))) {
  Copy-Item (Join-Path $Root ".env.example") (Join-Path $Root ".env")
  Write-Host "Created .env from .env.example. Review DATABASE_URL before continuing."
}
if (-not (Test-Path $VenvPython)) {
  Push-Location $Backend
  try {
    if (Get-Command py -ErrorAction SilentlyContinue) {
      $created = $false
      foreach ($ver in @("3.13", "3.12", "3.11")) {
        & py ("-" + $ver) -m venv .venv
        if ($LASTEXITCODE -eq 0) { $created = $true; break }
      }
      if (-not $created) { throw "Python 3.11–3.13 was not found via the Python launcher." }
    } else { python -m venv .venv }
  } finally { Pop-Location }
}
Push-Location $Backend
try {
  & $VenvPython -m pip install --upgrade pip
  & $VenvPython -m pip install -r requirements-dev.txt
  & $VenvPython -m alembic upgrade head
  # Seed only a truly empty database; never drop existing records from this setup script.
  $doctor = & $VenvPython -m app.doctor 2>&1
  $doctor | Write-Host
  if ($LASTEXITCODE -ne 0) { throw "Setup diagnostics failed. Resolve the doctor output above before seeding." }
  if (($doctor -join "`n") -match "Users: 0 total; 0 demo accounts") {
    & $VenvPython -m app.seed
  } else {
    Write-Host "Database already has users; skipped seeding to avoid duplicate or unwanted records."
  }
  Write-Host "Setup complete. Start backend with scripts\start-backend.ps1" -ForegroundColor Green
} finally { Pop-Location }
