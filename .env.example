# Copy to .env (repository root or backend/) and fill in. Never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://agastya:agastya@localhost:5432/agastya
# Quick local alternative without PostgreSQL (development only):
# DATABASE_URL=sqlite:///./agastya-dev.db
SECRET_KEY=replace-with-a-long-random-string
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Image storage: "local" (private folder, development) or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
MAX_UPLOAD_MB=8
IMAGE_RETENTION_DAYS=730

# Crop-vision model folder (model.onnx, model_card.json, ood_guard.npz)
MODEL_DIR=./ml_models/crop_vision
UNCERTAINTY_THRESHOLD=0.70

# Demo data and the login-screen account list (ignored when APP_ENV=production)
DEMO_MODE=true
# Optional fixed date for seeding, YYYY-MM-DD (defaults to today)
DEMO_DATE=
DEFAULT_TIMEZONE=Asia/Kolkata
HARVEST_UPCOMING_WINDOW_DAYS=3

# Serve the built frontend from the API process (optional single-process mode)
# FRONTEND_DIST=../frontend/dist
